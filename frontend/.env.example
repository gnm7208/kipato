# Where the app gets its data.
#   mock — self-contained demo data, no backend needed (default)
#   api  — talk to the Flask backend at VITE_API_BASE_URL
VITE_DATA_MODE=mock

# Base URL of the backend. Leave blank to call the same origin the app is
# served from. Must match one of the backend's FRONTEND_ORIGINS.
VITE_API_BASE_URL=http://localhost:5000

      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  .font-heading { font-family: 'Space Grotesk', sans-serif; }\n  .font-body { font-family: 'DM Sans', sans-serif; }\n  .safe-bottom { padding-bottom: calc(1rem + env(safe-area-inset-bottom)); }\n  .nav-safe-bottom { padding-bottom: env(safe-area-inset-bottom); }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"min-h-screen bg-[var(--color-canvas)] font-body text-[var(--color-ink)] antialiased\" data-kid=\"2\" data-name=\"Application wrapper container\" style=\"--color-canvas:#FAFAFA; --color-ink:#111111; --color-sun:#FFD800; --color-jade:#03C03C; --color-muted:#6B6B65;\">\n    <div class=\"mx-auto w-full max-w-md px-5 pb-32\" data-kid=\"2-1\" data-name=\"Main content layout container\">\n        <header class=\"flex items-center justify-between border-b-2 border-[var(--color-ink)] py-4\" data-kid=\"2-1-1\" data-name=\"Header bar\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"2-1-1-1\" data-name=\"Brand logo container\">\n                <span aria-hidden=\"true\" class=\"flex h-8 w-8 items-center justify-center rounded-full border-[3px] border-[var(--color-ink)] bg-[var(--color-ink)] text-lg font-heading font-bold text-[var(--color-sun)]\" data-kid=\"2-1-1-1-1\" data-name=\"Brand logo icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"2-1-1-1-1-1\" data-name=\"Right arrow icon\">\n                    </i>\n                </span>\n                <span class=\"font-heading text-[1.08rem] font-bold tracking-[0.16em]\" data-kid=\"2-1-1-1-2\" data-name=\"Brand name\">\n                    KIPATO\n                </span>\n            </div>\n            <button aria-label=\"Open profile\" class=\"flex h-11 w-11 items-center justify-center rounded-full border-[3px] border-[var(--color-ink)] bg-[var(--color-sun)] text-[1.35rem] shadow-[3px_3px_0_var(--color-ink)] outline-none transition-transform active:translate-x-0.5 active:translate-y-0.5 focus-visible:ring-4 focus-visible:ring-[var(--color-jade)]\" data-kid=\"2-1-1-2\" data-name=\"Open profile button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-user\" data-kid=\"2-1-1-2-1\" data-name=\"User icon\">\n                </i>\n            </button>\n        </header>\n        <main class=\"space-y-6 pt-6\" data-kid=\"2-1-2\" data-name=\"Main content area\">\n            <section aria-labelledby=\"greeting-title\" data-kid=\"2-1-2-1\" data-name=\"Greeting section\">\n                <p class=\"mb-2 text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[var(--color-muted)]\" data-kid=\"2-1-2-1-1\" data-name=\"Date text\">\n                    Tuesday · 03 Sep 2026\n                </p>\n                <h1 class=\"font-heading text-[2.25rem] font-bold leading-[0.98] tracking-[-0.06em]\" data-kid=\"2-1-2-1-2\" data-name=\"Greeting headline\" id=\"greeting-title\">\n                    Good morning,\n                    <br data-kid=\"2-1-2-1-2-1\" data-name=\"Line break\"/>\n                    <span class=\"text-[var(--color-jade)]\" data-kid=\"2-1-2-1-2-2\" data-name=\"User name text\">\n                        Amina.\n                    </span>\n                </h1>\n                <p class=\"mt-3 text-[0.95rem] font-medium text-[var(--color-muted)]\" data-kid=\"2-1-2-1-3\" data-name=\"Greeting subtitle\">\n                    Keep your record moving.\n                </p>\n            </section>\n            <section aria-labelledby=\"earnings-title\" class=\"relative overflow-hidden border-[3px] border-[var(--color-ink)] bg-[var(--color-ink)] p-5 text-white shadow-[4px_4px_0_var(--color-ink)]\" data-kid=\"2-1-2-2\" data-name=\"Earnings card\">\n                <div aria-hidden=\"true\" class=\"absolute right-0 top-0 h-14 w-14 bg-[var(--color-sun)]\" data-kid=\"2-1-2-2-1\" data-name=\"Decorative corner accent\">\n                </div>\n                <div class=\"relative flex items-start justify-between gap-3\" data-kid=\"2-1-2-2-2\" data-name=\"Earnings header container\">\n                    <p class=\"pt-1 text-[0.68rem] font-bold uppercase tracking-[0.18em] text-white/65\" data-kid=\"2-1-2-2-2-1\" data-name=\"Earnings title\" id=\"earnings-title\">\n                        This week's earnings\n                    </p>\n                    <span class=\"inline-flex shrink-0 items-center gap-1 border-2 border-[var(--color-ink)] bg-[var(--color-jade)] px-2 py-1 text-[0.68rem] font-bold text-[var(--color-ink)] shadow-[2px_2px_0_var(--color-canvas)]\" data-kid=\"2-1-2-2-2-2\" data-name=\"Earnings trend badge\">\n                        <i aria-hidden=\"true\" class=\"ti ti-trending-up text-[0.8rem]\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"Trending up icon\">\n                        </i>\n                        +12%\n                    </span>\n                </div>\n                <div class=\"relative mt-7\" data-kid=\"2-1-2-2-3\" data-name=\"Earnings amount section\">\n                    <p class=\"font-heading text-[3.35rem] font-bold leading-none tracking-[-0.075em]\" data-kid=\"2-1-2-2-3-1\" data-name=\"Total earnings amount\">\n                        KSh 14,250\n                    </p>\n                    <p class=\"mt-3 text-[0.78rem] font-medium text-white/65\" data-kid=\"2-1-2-2-3-2\" data-name=\"Comparison period text\">\n                        vs previous 7 days\n                    </p>\n                </div>\n                <div class=\"relative mt-7 flex items-end justify-between border-t-2 border-white/20 pt-3\" data-kid=\"2-1-2-2-4\" data-name=\"Earnings footer info\">\n                    <p class=\"text-[0.82rem] font-semibold\" data-kid=\"2-1-2-2-4-1\" data-name=\"Records count text\">\n                        5 records logged\n                    </p>\n                    <p class=\"flex items-center gap-1.5 text-[0.66rem] font-bold uppercase tracking-[0.12em] text-white/70\" data-kid=\"2-1-2-2-4-2\" data-name=\"Worker status label\">\n                        <i aria-hidden=\"true\" class=\"ti ti-rosette-discount-check-filled text-[0.9rem] text-[var(--color-jade)]\" data-kid=\"2-1-2-2-4-2-1\" data-name=\"Checkmark icon\">\n                        </i>\n                        Verified worker record\n                    </p>\n                </div>\n            </section>\n            <section aria-labelledby=\"quick-actions-title\" data-kid=\"2-1-2-3\" data-name=\"Quick actions section\">\n                <div class=\"mb-3 flex items-baseline justify-between\" data-kid=\"2-1-2-3-1\" data-name=\"Quick actions header container\">\n                    <h2 class=\"font-heading text-[1.1rem] font-bold tracking-[-0.03em]\" data-kid=\"2-1-2-3-1-1\" data-name=\"Quick actions title\" id=\"quick-actions-title\">\n                        Keep it current\n                    </h2>\n                    <span class=\"text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[var(--color-muted)]\" data-kid=\"2-1-2-3-1-2\" data-name=\"Quick actions label\">\n                        Quick actions\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-[1.22fr_0.92fr] gap-3\" data-kid=\"2-1-2-3-2\" data-name=\"Quick actions button group\">\n                    <button aria-label=\"Log cash income\" class=\"flex min-h-[126px] flex-col justify-between border-[3px] border-[var(--color-ink)] bg-[var(--color-sun)] p-4 text-left shadow-[4px_4px_0_var(--color-ink)] outline-none transition-transform active:translate-x-0.5 active:translate-y-0.5 focus-visible:ring-4 focus-visible:ring-[var(--color-jade)]\" data-kid=\"2-1-2-3-2-1\" data-name=\"Log cash income button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"flex h-11 w-11 items-center justify-center border-[3px] border-[var(--color-ink)] bg-[var(--color-ink)] text-[1.45rem] text-[var(--color-sun)]\" data-kid=\"2-1-2-3-2-1-1\" data-name=\"Log cash icon container\">\n                            <i class=\"ti ti-circle-plus-filled\" data-kid=\"2-1-2-3-2-1-1-1\" data-name=\"Plus icon\">\n                            </i>\n                        </span>\n                        <span class=\"flex items-end justify-between gap-2\" data-kid=\"2-1-2-3-2-1-2\" data-name=\"Log cash button label container\">\n                            <span data-kid=\"2-1-2-3-2-1-2-1\" data-name=\"Log cash label text container\">\n                                <span class=\"block font-heading text-[1.22rem] font-bold leading-none\" data-kid=\"2-1-2-3-2-1-2-1-1\" data-name=\"Log cash button title\">\n                                    Log cash\n                                </span>\n                                <span class=\"mt-1 block text-[0.72rem] font-semibold\" data-kid=\"2-1-2-3-2-1-2-1-2\" data-name=\"Log cash button subtitle\">\n                                    Add today's earning\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[1.3rem]\" data-kid=\"2-1-2-3-2-1-2-2\" data-name=\"Arrow icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-label=\"Import M-PESA records\" class=\"flex min-h-[126px] flex-col justify-between border-[3px] border-dashed border-[var(--color-ink)] bg-white p-4 text-left outline-none transition-transform active:translate-x-0.5 active:translate-y-0.5 focus-visible:ring-4 focus-visible:ring-[var(--color-jade)]\" data-kid=\"2-1-2-3-2-2\" data-name=\"Import MPESA button\" type=\"button\">\n                        <span aria-hidden=\"true\" class=\"flex h-10 w-10 items-center justify-center border-2 border-[var(--color-ink)] bg-[var(--color-canvas)] text-[1.25rem]\" data-kid=\"2-1-2-3-2-2-1\" data-name=\"Import icon container\">\n                            <i class=\"ti ti-message-2\" data-kid=\"2-1-2-3-2-2-1-1\" data-name=\"Message icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"2-1-2-3-2-2-2\" data-name=\"Import button label container\">\n                            <span class=\"block font-heading text-[1rem] font-bold leading-[1.05]\" data-kid=\"2-1-2-3-2-2-2-1\" data-name=\"Import button title\">\n                                Import\n                                <br data-kid=\"2-1-2-3-2-2-2-1-1\" data-name=\"Line break\"/>\n                                M-PESA\n                            </span>\n                            <span class=\"mt-1 block text-[0.68rem] font-semibold text-[var(--color-muted)]\" data-kid=\"2-1-2-3-2-2-2-2\" data-name=\"Import button subtitle\">\n                                Paste a message\n                            </span>\n                        </span>\n                    </button>\n                </div>\n            </section>\n            <section aria-labelledby=\"activity-title\" data-kid=\"2-1-2-4\" data-name=\"Recent activity section\">\n                <div class=\"mb-2 flex items-end justify-between\" data-kid=\"2-1-2-4-1\" data-name=\"Activity header container\">\n                    <div data-kid=\"2-1-2-4-1-1\" data-name=\"Activity title container\">\n                        <p class=\"text-[0.68rem] font-bold uppercase tracking-[0.18em] text-[var(--color-muted)]\" data-kid=\"2-1-2-4-1-1-1\" data-name=\"Activity pre-title\">\n                            Your proof, in motion\n                        </p>\n                        <h2 class=\"mt-1 font-heading text-[1.45rem] font-bold tracking-[-0.045em]\" data-kid=\"2-1-2-4-1-1-2\" data-name=\"Activity section title\" id=\"activity-title\">\n                            Recent activity\n                        </h2>\n                    </div>\n                    <button aria-label=\"View all income records\" class=\"min-h-11 px-1 text-[0.72rem] font-bold underline decoration-2 underline-offset-4 outline-none focus-visible:ring-4 focus-visible:ring-[var(--color-jade)]\" data-kid=\"2-1-2-4-1-2\" data-name=\"View all button\" type=\"button\">\n                        View all\n                    </button>\n                </div>\n                <div class=\"border-t-[3px] border-[var(--color-ink)]\" data-kid=\"2-1-2-4-2\" data-name=\"Activity list container\">\n                    <div class=\"grid grid-cols-[4.4rem_1fr_auto] items-center gap-3 border-b-2 border-[var(--color-ink)] py-4\" data-kid=\"2-1-2-4-2-1\" data-name=\"Activity item one\">\n                        <div data-kid=\"2-1-2-4-2-1-1\" data-name=\"Activity date container\">\n                            <p class=\"font-heading text-[0.78rem] font-bold\" data-kid=\"2-1-2-4-2-1-1-1\" data-name=\"Activity day text\">\n                                Today\n                            </p>\n                            <p class=\"mt-0.5 text-[0.64rem] font-medium text-[var(--color-muted)]\" data-kid=\"2-1-2-4-2-1-1-2\" data-name=\"Activity date text\">\n                                03 Sep\n                            </p>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-1-2-4-2-1-2\" data-name=\"Activity details container\">\n                            <p class=\"truncate text-[0.9rem] font-bold\" data-kid=\"2-1-2-4-2-1-2-1\" data-name=\"Activity description text\">\n                                Boda Boda\n                            </p>\n                            <p class=\"mt-1 flex items-center gap-1.5 text-[0.65rem] font-bold uppercase tracking-[0.1em] text-[var(--color-muted)]\" data-kid=\"2-1-2-4-2-1-2-2\" data-name=\"Activity type container\">\n                                <span aria-hidden=\"true\" class=\"h-2 w-2 bg-[var(--color-sun)]\" data-kid=\"2-1-2-4-2-1-2-2-1\" data-name=\"Activity type indicator\">\n                                </span>\n                                Cash\n                            </p>\n                        </div>\n                        <p class=\"font-heading text-[0.96rem] font-bold\" data-kid=\"2-1-2-4-2-1-3\" data-name=\"Activity amount text\">\n                            +KSh 2,400\n                        </p>\n                    </div>\n                    <div class=\"grid grid-cols-[4.4rem_1fr_auto] items-center gap-3 border-b-2 border-[var(--color-ink)] py-4\" data-kid=\"2-1-2-4-2-2\" data-name=\"Activity item two\">\n                        <div data-kid=\"2-1-2-4-2-2-1\" data-name=\"Activity date container\">\n                            <p class=\"font-heading text-[0.78rem] font-bold\" data-kid=\"2-1-2-4-2-2-1-1\" data-name=\"Activity day text\">\n                                Yesterday\n                            </p>\n                            <p class=\"mt-0.5 text-[0.64rem] font-medium text-[var(--color-muted)]\" data-kid=\"2-1-2-4-2-2-1-2\" data-name=\"Activity date text\">\n                                02 Sep\n                            </p>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-1-2-4-2-2-2\" data-name=\"Activity details container\">\n                            <p class=\"truncate text-[0.9rem] font-bold\" data-kid=\"2-1-2-4-2-2-2-1\" data-name=\"Activity description text\">\n                                Shop shift\n                            </p>\n                            <p class=\"mt-1 flex items-center gap-1.5 text-[0.65rem] font-bold uppercase tracking-[0.1em] text-[var(--color-muted)]\" data-kid=\"2-1-2-4-2-2-2-2\" data-name=\"Activity type container\">\n                                <span aria-hidden=\"true\" class=\"h-2 w-2 bg-[var(--color-sun)]\" data-kid=\"2-1-2-4-2-2-2-2-1\" data-name=\"Activity type indicator\">\n                                </span>\n                                Cash\n                            </p>\n                        </div>\n                        <p class=\"font-heading text-[0.96rem] font-bold\" data-kid=\"2-1-2-4-2-2-3\" data-name=\"Activity amount text\">\n                            +KSh 1,850\n                        </p>\n                    </div>\n                    <div class=\"grid grid-cols-[4.4rem_1fr_auto] items-center gap-3 border-b-2 border-[var(--color-ink)] py-4\" data-kid=\"2-1-2-4-2-3\" data-name=\"Activity item three\">\n                        <div data-kid=\"2-1-2-4-2-3-1\" data-name=\"Activity date container\">\n                            <p class=\"font-heading text-[0.78rem] font-bold\" data-kid=\"2-1-2-4-2-3-1-1\" data-name=\"Activity day text\">\n                                Mon, 02\n                            </p>\n                            <p class=\"mt-0.5 text-[0.64rem] font-medium text-[var(--color-muted)]\" data-kid=\"2-1-2-4-2-3-1-2\" data-name=\"Activity date text\">\n                                Sep 2026\n                            </p>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"2-1-2-4-2-3-2\" data-name=\"Activity details container\">\n                            <p class=\"truncate text-[0.9rem] font-bold\" data-kid=\"2-1-2-4-2-3-2-1\" data-name=\"Activity description text\">\n                                M-PESA\n                            </p>\n                            <p class=\"mt-1 flex items-center gap-1.5 text-[0.65rem] font-bold uppercase tracking-[0.1em] text-[var(--color-muted)]\" data-kid=\"2-1-2-4-2-3-2-2\" data-name=\"Activity type container\">\n                                <span aria-hidden=\"true\" class=\"h-2 w-2 bg-[var(--color-jade)]\" data-kid=\"2-1-2-4-2-3-2-2-1\" data-name=\"Activity type indicator\">\n                                </span>\n                                Imported\n                            </p>\n                        </div>\n                        <p class=\"font-heading text-[0.96rem] font-bold\" data-kid=\"2-1-2-4-2-3-3\" data-name=\"Activity amount text\">\n                            +KSh 3,000\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <div class=\"flex items-center justify-between gap-3 border-2 border-[var(--color-ink)] bg-white px-3 py-3.5\" data-kid=\"2-1-2-5\" data-name=\"Offline sync status bar\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"2-1-2-5-1\" data-name=\"Sync status label container\">\n                    <span aria-hidden=\"true\" class=\"flex h-7 w-7 items-center justify-center bg-[var(--color-jade)] text-[var(--color-ink)]\" data-kid=\"2-1-2-5-1-1\" data-name=\"Sync icon container\">\n                        <i class=\"ti ti-cloud-check text-[1rem]\" data-kid=\"2-1-2-5-1-1-1\" data-name=\"Sync icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"2-1-2-5-1-2\" data-name=\"Sync text content\">\n                        <p class=\"text-[0.78rem] font-bold\" data-kid=\"2-1-2-5-1-2-1\" data-name=\"Sync status title\">\n                            Ready to record offline\n                        </p>\n                        <p class=\"mt-0.5 text-[0.66rem] font-medium text-[var(--color-muted)]\" data-kid=\"2-1-2-5-1-2-2\" data-name=\"Sync status subtitle\">\n                            Syncs when you're back online\n                        </p>\n                    </div>\n                </div>\n                <span aria-label=\"Online and ready\" class=\"h-2.5 w-2.5 shrink-0 rounded-full bg-[var(--color-jade)] ring-2 ring-[var(--color-ink)]\" data-kid=\"2-1-2-5-2\" data-name=\"Sync status indicator\">\n                </span>\n            </div>\n        </main>\n    </div>\n    <nav aria-label=\"Primary navigation\" class=\"fixed inset-x-0 bottom-0 z-20 border-t-[3px] border-[var(--color-ink)] bg-white/95 backdrop-blur-sm nav-safe-bottom\" data-kid=\"2-2\" data-name=\"Bottom navigation bar\">\n        <div class=\"mx-auto grid max-w-md grid-cols-4\" data-kid=\"2-2-1\" data-name=\"Navigation links container\">\n            <button aria-current=\"page\" aria-label=\"Home, current page\" class=\"flex min-h-[68px] flex-col items-center justify-center gap-1 border-t-[4px] border-[var(--color-ink)] px-1 pt-1 text-[var(--color-ink)] outline-none focus-visible:bg-[var(--color-sun)]\" data-kid=\"2-2-1-1\" data-name=\"Home navigation button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-home-2 text-[1.3rem]\" data-kid=\"2-2-1-1-1\" data-name=\"Home icon\">\n                </i>\n                <span class=\"text-[0.64rem] font-bold\" data-kid=\"2-2-1-1-2\" data-name=\"Home label\">\n                    Home\n                </span>\n            </button>\n            <button aria-label=\"Trends\" class=\"flex min-h-[68px] flex-col items-center justify-center gap-1 border-t-[4px] border-transparent px-1 pt-1 text-[var(--color-muted)] outline-none focus-visible:bg-[var(--color-sun)]\" data-kid=\"2-2-1-2\" data-name=\"Trends navigation button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-chart-bar text-[1.3rem]\" data-kid=\"2-2-1-2-1\" data-name=\"Trends icon\">\n                </i>\n                <span class=\"text-[0.64rem] font-bold\" data-kid=\"2-2-1-2-2\" data-name=\"Trends label\">\n                    Trends\n                </span>\n            </button>\n            <button aria-label=\"Imports\" class=\"flex min-h-[68px] flex-col items-center justify-center gap-1 border-t-[4px] border-transparent px-1 pt-1 text-[var(--color-muted)] outline-none focus-visible:bg-[var(--color-sun)]\" data-kid=\"2-2-1-3\" data-name=\"Imports navigation button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-message-import text-[1.3rem]\" data-kid=\"2-2-1-3-1\" data-name=\"Imports icon\">\n                </i>\n                <span class=\"text-[0.64rem] font-bold\" data-kid=\"2-2-1-3-2\" data-name=\"Imports label\">\n                    Imports\n                </span>\n            </button>\n            <button aria-label=\"Statements\" class=\"flex min-h-[68px] flex-col items-center justify-center gap-1 border-t-[4px] border-transparent px-1 pt-1 text-[var(--color-muted)] outline-none focus-visible:bg-[var(--color-sun)]\" data-kid=\"2-2-1-4\" data-name=\"Statements navigation button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-file-invoice text-[1.3rem]\" data-kid=\"2-2-1-4-1\" data-name=\"Statements icon\">\n                </i>\n                <span class=\"text-[0.64rem] font-bold\" data-kid=\"2-2-1-4-2\" data-name=\"Statements label\">\n                    Statements\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",

      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/tabler-icons.min.css');\n</style>\n<div class=\"relative min-h-[812px] w-full overflow-hidden bg-[#FAFAFA] text-[#111111]\" data-kid=\"1\" data-name=\"page layout container\" style=\"--canvas:#FAFAFA;--ink:#111111;--sun:#FFD800;--jade:#03C03C;font-family:'DM Sans',sans-serif;\">\n    <section aria-label=\"Worker home preview\" class=\"absolute inset-0 bg-[#FAFAFA]\" data-kid=\"1-1\" data-name=\"worker home preview section\">\n        <header class=\"flex h-[76px] items-center justify-between border-b-[3px] border-[#111111] px-5\" data-kid=\"1-1-1\" data-name=\"header container\">\n            <div class=\"flex flex-col gap-0.5\" data-kid=\"1-1-1-1\" data-name=\"title branding container\">\n                <span class=\"text-[21px] font-bold tracking-[-0.08em]\" data-kid=\"1-1-1-1-1\" data-name=\"app name text\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                    KIPATO\n                </span>\n                <span class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#6B6B65]\" data-kid=\"1-1-1-1-2\" data-name=\"subtitle text\">\n                    Your record, at a glance\n                </span>\n            </div>\n            <button aria-label=\"Open profile\" class=\"flex h-11 w-11 items-center justify-center border-[3px] border-[#111111] bg-[#FFD800] text-[21px] shadow-[3px_3px_0_#111111]\" data-kid=\"1-1-1-2\" data-name=\"open profile button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-user\" data-kid=\"1-1-1-2-1\" data-name=\"user profile icon\">\n                </i>\n            </button>\n        </header>\n        <main class=\"space-y-4 px-5 pb-24 pt-5\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <div class=\"border-[3px] border-[#111111] bg-[#111111] p-5 text-[#FAFAFA] shadow-[5px_5px_0_#FFD800]\" data-kid=\"1-1-2-1\" data-name=\"earnings overview card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-2-1-1\" data-name=\"earnings header container\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[#FFD800]\" data-kid=\"1-1-2-1-1-1\" data-name=\"earnings header label\">\n                        This week's earnings\n                    </p>\n                    <span class=\"border-2 border-[#03C03C] bg-[#03C03C] px-2 py-1 text-[10px] font-bold text-[#111111]\" data-kid=\"1-1-2-1-1-2\" data-name=\"earnings percentage change badge\">\n                        +12%\n                    </span>\n                </div>\n                <p class=\"mt-4 text-[42px] font-bold leading-none tracking-[-0.08em]\" data-kid=\"1-1-2-1-2\" data-name=\"total earnings amount text\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                    KSh 14,250\n                </p>\n                <div class=\"mt-5 flex items-center justify-between border-t border-[#FAFAFA]/30 pt-3 text-[11px] text-[#FAFAFA]/70\" data-kid=\"1-1-2-1-3\" data-name=\"earnings footer info container\">\n                    <span data-kid=\"1-1-2-1-3-1\" data-name=\"earnings vs last week text\">\n                        vs last week\n                    </span>\n                    <span class=\"font-semibold text-[#03C03C]\" data-kid=\"1-1-2-1-3-2\" data-name=\"earnings status text\">\n                        Growing steadily\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid grid-cols-[1.25fr_1fr] gap-3\" data-kid=\"1-1-2-2\" data-name=\"quick actions grid\">\n                <button aria-label=\"Log cash income\" class=\"flex min-h-[112px] flex-col justify-between border-[3px] border-[#111111] bg-[#FFD800] p-4 text-left shadow-[4px_4px_0_#111111]\" data-kid=\"1-1-2-2-1\" data-name=\"log cash income button\" type=\"button\">\n                    <span class=\"flex h-10 w-10 items-center justify-center border-2 border-[#111111] text-[24px]\" data-kid=\"1-1-2-2-1-1\" data-name=\"log cash icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-circle-plus\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"plus icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[17px] font-bold leading-none\" data-kid=\"1-1-2-2-1-2\" data-name=\"log cash button label\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                        Log cash\n                    </span>\n                </button>\n                <button aria-label=\"Import M-PESA records\" class=\"flex min-h-[112px] flex-col justify-between border-[3px] border-dashed border-[#111111] bg-[#FAFAFA] p-4 text-left\" data-kid=\"1-1-2-2-2\" data-name=\"import mp-esa records button\" type=\"button\">\n                    <span class=\"flex h-10 w-10 items-center justify-center border-2 border-[#111111] text-[22px]\" data-kid=\"1-1-2-2-2-1\" data-name=\"import icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"ti ti-message-2\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"message icon\">\n                        </i>\n                    </span>\n                    <span class=\"text-[15px] font-bold leading-none\" data-kid=\"1-1-2-2-2-2\" data-name=\"import button label\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                        Import M-PESA\n                    </span>\n                </button>\n            </div>\n            <div data-kid=\"1-1-2-3\" data-name=\"recent activity section\">\n                <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-1-2-3-1\" data-name=\"recent activity header\">\n                    <h2 class=\"text-[13px] font-bold uppercase tracking-[0.14em]\" data-kid=\"1-1-2-3-1-1\" data-name=\"recent activity title\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                        Recent activity\n                    </h2>\n                    <span class=\"text-[11px] font-semibold text-[#6B6B65]\" data-kid=\"1-1-2-3-1-2\" data-name=\"activity count text\">\n                        3 records\n                    </span>\n                </div>\n                <div class=\"divide-y-2 divide-[#111111]/15 border-y-2 border-[#111111]/15\" data-kid=\"1-1-2-3-2\" data-name=\"activity list container\">\n                    <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"1-1-2-3-2-1\" data-name=\"activity row 1 container\">\n                        <div data-kid=\"1-1-2-3-2-1-1\" data-name=\"activity details container\">\n                            <p class=\"text-[13px] font-bold\" data-kid=\"1-1-2-3-2-1-1-1\" data-name=\"activity date text\">\n                                Today\n                            </p>\n                            <p class=\"text-[11px] text-[#6B6B65]\" data-kid=\"1-1-2-3-2-1-1-2\" data-name=\"activity category and method\">\n                                Boda boda · Cash\n                            </p>\n                        </div>\n                        <span class=\"text-[15px] font-bold\" data-kid=\"1-1-2-3-2-1-2\" data-name=\"activity amount text\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                            + KSh 1,850\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"1-1-2-3-2-2\" data-name=\"activity row 2 container\">\n                        <div data-kid=\"1-1-2-3-2-2-1\" data-name=\"activity details container\">\n                            <p class=\"text-[13px] font-bold\" data-kid=\"1-1-2-3-2-2-1-1\" data-name=\"activity date text\">\n                                Yesterday\n                            </p>\n                            <p class=\"text-[11px] text-[#6B6B65]\" data-kid=\"1-1-2-3-2-2-1-2\" data-name=\"activity category and method\">\n                                Shop delivery · M-PESA\n                            </p>\n                        </div>\n                        <span class=\"text-[15px] font-bold\" data-kid=\"1-1-2-3-2-2-2\" data-name=\"activity amount text\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                            + KSh 2,400\n                        </span>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"1-1-2-3-2-3\" data-name=\"activity row 3 container\">\n                        <div data-kid=\"1-1-2-3-2-3-1\" data-name=\"activity details container\">\n                            <p class=\"text-[13px] font-bold\" data-kid=\"1-1-2-3-2-3-1-1\" data-name=\"activity date text\">\n                                Mon, 08 Sep\n                            </p>\n                            <p class=\"text-[11px] text-[#6B6B65]\" data-kid=\"1-1-2-3-2-3-1-2\" data-name=\"activity category and method\">\n                                Repairs · Cash\n                            </p>\n                        </div>\n                        <span class=\"text-[15px] font-bold\" data-kid=\"1-1-2-3-2-3-2\" data-name=\"activity amount text\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                            + KSh 3,200\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </main>\n        <nav aria-label=\"Primary navigation\" class=\"absolute inset-x-0 bottom-0 grid h-[72px] grid-cols-4 border-t-[3px] border-[#111111] bg-[#FAFAFA] px-2 pb-2 pt-1\" data-kid=\"1-1-3\" data-name=\"primary navigation bar\">\n            <button aria-current=\"page\" class=\"flex flex-col items-center justify-center gap-1 border-t-[4px] border-[#FFD800] text-[10px] font-bold\" data-kid=\"1-1-3-1\" data-name=\"home nav button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-home text-[20px]\" data-kid=\"1-1-3-1-1\" data-name=\"home icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"home label\">\n                    Home\n                </span>\n            </button>\n            <button aria-label=\"View trends\" class=\"flex flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#6B6B65]\" data-kid=\"1-1-3-2\" data-name=\"trends nav button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-chart-bar text-[20px]\" data-kid=\"1-1-3-2-1\" data-name=\"trends icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"trends label\">\n                    Trends\n                </span>\n            </button>\n            <button aria-label=\"View imports\" class=\"flex flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#6B6B65]\" data-kid=\"1-1-3-3\" data-name=\"imports nav button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-message-2 text-[20px]\" data-kid=\"1-1-3-3-1\" data-name=\"imports icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"imports label\">\n                    Imports\n                </span>\n            </button>\n            <button aria-label=\"View statements\" class=\"flex flex-col items-center justify-center gap-1 text-[10px] font-semibold text-[#6B6B65]\" data-kid=\"1-1-3-4\" data-name=\"statements nav button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-file-invoice text-[20px]\" data-kid=\"1-1-3-4-1\" data-name=\"statements icon\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\" data-name=\"statements label\">\n                    Statements\n                </span>\n            </button>\n        </nav>\n    </section>\n    <div aria-hidden=\"true\" class=\"absolute inset-0 z-10 bg-[#111111]/75\" data-kid=\"1-2\" data-name=\"overlay background\">\n    </div>\n    <section aria-labelledby=\"log-income-title\" aria-modal=\"true\" class=\"absolute inset-x-0 bottom-0 z-20 h-[585px] overflow-hidden rounded-t-md border-t-[3px] border-[#111111] bg-[#FAFAFA] shadow-[0_-5px_0_#111111]\" data-kid=\"1-3\" data-name=\"log income modal dialog\" role=\"dialog\">\n        <div class=\"flex h-full flex-col\" data-kid=\"1-3-1\" data-name=\"modal inner container\">\n            <div class=\"flex justify-center pt-3\" data-kid=\"1-3-1-1\" data-name=\"modal grab handle container\">\n                <span aria-hidden=\"true\" class=\"h-1.5 w-16 bg-[#111111]\" data-kid=\"1-3-1-1-1\" data-name=\"grab handle bar\">\n                </span>\n            </div>\n            <div class=\"flex items-start justify-between px-5 pb-3 pt-3\" data-kid=\"1-3-1-2\" data-name=\"modal header\">\n                <div data-kid=\"1-3-1-2-1\" data-name=\"modal title area\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#6B6B65]\" data-kid=\"1-3-1-2-1-1\" data-name=\"modal subtitle\">\n                        Quick record\n                    </p>\n                    <h1 class=\"mt-1 text-[25px] font-bold leading-none tracking-[-0.06em]\" data-kid=\"1-3-1-2-1-2\" data-name=\"modal title\" id=\"log-income-title\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                        Log income\n                    </h1>\n                </div>\n                <button aria-label=\"Close log income sheet\" class=\"flex h-11 w-11 items-center justify-center border-[3px] border-[#111111] bg-[#FAFAFA] text-[22px] shadow-[3px_3px_0_#111111]\" data-kid=\"1-3-1-2-2\" data-name=\"close modal button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"1-3-1-2-2-1\" data-name=\"close icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"min-h-0 flex-1 overflow-y-auto px-5 pb-28\" data-kid=\"1-3-1-3\" data-name=\"modal scrollable content\">\n                <div class=\"border-y-[3px] border-[#111111] py-3\" data-kid=\"1-3-1-3-1\" data-name=\"amount input section\">\n                    <label class=\"block text-[10px] font-bold uppercase tracking-[0.16em] text-[#6B6B65]\" data-kid=\"1-3-1-3-1-1\" data-name=\"amount label\" for=\"amount\">\n                        Amount\n                    </label>\n                    <div class=\"mt-1 flex items-baseline gap-2\" data-kid=\"1-3-1-3-1-2\" data-name=\"amount input wrapper\">\n                        <span class=\"text-[18px] font-bold text-[#6B6B65]\" data-kid=\"1-3-1-3-1-2-1\" data-name=\"amount currency prefix\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                            KSh\n                        </span>\n                        <input aria-label=\"Income amount in Kenyan shillings\" class=\"min-w-0 flex-1 bg-transparent p-0 text-[58px] font-bold leading-none tracking-[-0.1em] outline-hidden\" data-kid=\"1-3-1-3-1-2-2\" data-name=\"amount input field\" id=\"amount\" style=\"font-family:'Space Grotesk',sans-serif;\" type=\"text\" value=\"0\"/>\n                    </div>\n                </div>\n                <div class=\"mt-3\" data-kid=\"1-3-1-3-2\" data-name=\"quick note section\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-3-1-3-2-1\" data-name=\"quick note header\">\n                        <label class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#6B6B65]\" data-kid=\"1-3-1-3-2-1-1\" data-name=\"quick note label\">\n                            Quick note\n                        </label>\n                        <span class=\"text-[10px] font-semibold text-[#6B6B65]\" data-kid=\"1-3-1-3-2-1-2\" data-name=\"quick note helper text\">\n                            Prefills your note\n                        </span>\n                    </div>\n                    <div aria-label=\"Quick note choices\" class=\"mt-2 flex gap-2 overflow-x-auto pb-1\" data-kid=\"1-3-1-3-2-2\" data-name=\"quick note choices\">\n                        <button aria-pressed=\"true\" class=\"min-h-11 shrink-0 border-2 border-[#111111] bg-[#111111] px-4 text-[12px] font-bold text-[#FAFAFA]\" data-kid=\"1-3-1-3-2-2-1\" data-name=\"quick note option 1 button\" type=\"button\">\n                            Transport\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-11 shrink-0 border-2 border-[#111111] bg-[#FAFAFA] px-4 text-[12px] font-bold\" data-kid=\"1-3-1-3-2-2-2\" data-name=\"quick note option 2 button\" type=\"button\">\n                            Sales\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-11 shrink-0 border-2 border-[#111111] bg-[#FAFAFA] px-4 text-[12px] font-bold\" data-kid=\"1-3-1-3-2-2-3\" data-name=\"quick note option 3 button\" type=\"button\">\n                            Labour\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-11 shrink-0 border-2 border-[#111111] bg-[#FAFAFA] px-4 text-[12px] font-bold\" data-kid=\"1-3-1-3-2-2-4\" data-name=\"quick note option 4 button\" type=\"button\">\n                            Other\n                        </button>\n                    </div>\n                </div>\n                <button aria-label=\"Edit income date and time\" class=\"mt-3 flex min-h-12 w-full items-center justify-between border-2 border-[#111111] bg-[#FAFAFA] px-3 text-left\" data-kid=\"1-3-1-3-3\" data-name=\"edit date button\" type=\"button\">\n                    <span data-kid=\"1-3-1-3-3-1\" data-name=\"date selection text container\">\n                        <span class=\"block text-[10px] font-bold uppercase tracking-[0.16em] text-[#6B6B65]\" data-kid=\"1-3-1-3-3-1-1\" data-name=\"date label\">\n                            Date\n                        </span>\n                        <span class=\"mt-0.5 block text-[14px] font-bold\" data-kid=\"1-3-1-3-3-1-2\" data-name=\"date value text\">\n                            Today, 4:30 PM\n                        </span>\n                    </span>\n                    <span class=\"flex h-9 w-9 items-center justify-center bg-[#FFD800] text-[19px]\" data-kid=\"1-3-1-3-3-2\" data-name=\"edit icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-pencil\" data-kid=\"1-3-1-3-3-2-1\" data-name=\"edit icon\">\n                        </i>\n                    </span>\n                </button>\n                <fieldset class=\"mt-3\" data-kid=\"1-3-1-3-4\" data-name=\"payment method fieldset\">\n                    <legend class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#6B6B65]\" data-kid=\"1-3-1-3-4-1\" data-name=\"method legend\">\n                        Method\n                    </legend>\n                    <div class=\"mt-2 grid grid-cols-2 border-[3px] border-[#111111] p-1\" data-kid=\"1-3-1-3-4-2\" data-name=\"method toggle container\">\n                        <button aria-pressed=\"true\" class=\"min-h-11 bg-[#111111] text-[13px] font-bold text-[#FAFAFA]\" data-kid=\"1-3-1-3-4-2-1\" data-name=\"cash method button\" type=\"button\">\n                            Cash\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-11 text-[13px] font-bold\" data-kid=\"1-3-1-3-4-2-2\" data-name=\"mp-esa method button\" type=\"button\">\n                            M-PESA\n                        </button>\n                    </div>\n                </fieldset>\n                <div class=\"mt-3\" data-kid=\"1-3-1-3-5\" data-name=\"note input section\">\n                    <label class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#6B6B65]\" data-kid=\"1-3-1-3-5-1\" data-name=\"note label\" for=\"note\">\n                        Note\n                        <span class=\"font-normal normal-case tracking-normal\" data-kid=\"1-3-1-3-5-1-1\" data-name=\"note optional label\">\n                            (optional)\n                        </span>\n                    </label>\n                    <input aria-describedby=\"note-help\" class=\"mt-2 h-12 w-full border-2 border-[#111111] bg-[#FAFAFA] px-3 text-[14px] font-semibold outline-hidden focus:ring-2 focus:ring-[#FFD800]\" data-kid=\"1-3-1-3-5-2\" data-name=\"note text input field\" id=\"note\" type=\"text\" value=\"Transport\"/>\n                    <p class=\"mt-1 text-[10px] text-[#6B6B65]\" data-kid=\"1-3-1-3-5-3\" data-name=\"note helper text\" id=\"note-help\">\n                        Selected quick note is ready to save with this record.\n                    </p>\n                </div>\n                <div class=\"mt-3 flex items-center gap-2 border-t-2 border-[#111111]/15 pt-3 text-[11px] font-semibold text-[#6B6B65]\" data-kid=\"1-3-1-3-6\" data-name=\"offline status indicator\">\n                    <span class=\"flex h-6 w-6 items-center justify-center border-2 border-[#03C03C] text-[14px] text-[#03C03C]\" data-kid=\"1-3-1-3-6-1\" data-name=\"floppy icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-device-floppy\" data-kid=\"1-3-1-3-6-1-1\" data-name=\"floppy icon\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-3-1-3-6-2\" data-name=\"offline status text\">\n                        Saved on this device when offline\n                    </span>\n                </div>\n            </div>\n            <div class=\"absolute inset-x-0 bottom-0 border-t-2 border-[#111111] bg-[#FAFAFA] px-5 pb-5 pt-3\" data-kid=\"1-3-1-4\" data-name=\"modal footer\">\n                <button aria-label=\"Save income record\" class=\"flex min-h-14 w-full items-center justify-between border-[3px] border-[#111111] bg-[#FFD800] px-4 text-left text-[16px] font-bold shadow-[4px_4px_0_#111111]\" data-kid=\"1-3-1-4-1\" data-name=\"save button\" type=\"button\">\n                    <span data-kid=\"1-3-1-4-1-1\" data-name=\"save button label\" style=\"font-family:'Space Grotesk',sans-serif;\">\n                        Save record\n                    </span>\n                    <span class=\"flex h-9 w-9 items-center justify-center border-2 border-[#111111] text-[20px]\" data-kid=\"1-3-1-4-1-2\" data-name=\"save icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-3-1-4-1-2-1\" data-name=\"arrow icon\">\n                        </i>\n                    </span>\n                </button>\n            </div>\n        </div>\n    </section>\n</div>\n",
      "comments": [],
      "created": "2026-09-01T18:43:46.798206+00:00",
      "modified": "2026-09-01T18:47:37.213706+00:00",
      "id": "var_5dd8253d52e6"
    },
    "var_82ab753fcf69": {
      "type": "variant",
      "label": "Kipato Proof and Analytics",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 950,
        "y": 0,
        "w": 888,
        "h": 793
      },
      "html": "<div class=\"min-h-screen w-full font-body\" data-kid=\"1\" data-name=\"page layout container\" style=\"--canvas:#FAFAFA; --ink:#111111; --sun:#FFD800; --jade:#03C03C; --muted:#6B6B65; --paper:#FFFFFF; background:var(--canvas); color:var(--ink);\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css');\n    .font-body { font-family: 'DM Sans', sans-serif; }\n    .font-display { font-family: 'Space Grotesk', sans-serif; }\n    .kp-ticket-perforations {\n      background-image: radial-gradient(circle at 50% 8px, var(--canvas) 0 4px, transparent 4.5px);\n      background-position: 0 0;\n      background-size: 10px 18px;\n      background-repeat: repeat-y;\n    }\n    .kp-barcode {\n      background-image: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 8px, var(--ink) 8px 11px, transparent 11px 13px);\n    }\n    .kp-ticket-rule { border-top: 2px dashed rgba(17,17,17,.45); }\n    </style>\n    <main class=\"mx-auto max-w-[375px] px-4 pb-32 pt-5\" data-kid=\"1-1\" data-name=\"main content area\">\n        <header class=\"mb-7 flex items-start justify-between gap-4\" data-kid=\"1-1-1\" data-name=\"header section\">\n            <div class=\"flex items-start gap-3\" data-kid=\"1-1-1-1\" data-name=\"back button container\">\n                <button aria-label=\"Back\" class=\"mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center border-[3px] border-(--ink) bg-(--paper) shadow-[3px_3px_0_var(--ink)]\" data-kid=\"1-1-1-1-1\" data-name=\"back button\" type=\"button\">\n                    <i class=\"ti ti-arrow-left text-[21px] leading-none\" data-kid=\"1-1-1-1-1-1\" data-name=\"left arrow icon\" style=\"width:21px;height:21px;color:var(--ink);\">\n                    </i>\n                </button>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"page title container\">\n                    <p class=\"mb-1 text-[10px] font-bold uppercase tracking-[0.16em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"subheading label\" style=\"color:var(--muted);\">\n                        Statements\n                    </p>\n                    <h1 class=\"font-display text-[29px] font-bold leading-[0.95] tracking-[-0.055em]\" data-kid=\"1-1-1-1-2-2\" data-name=\"main page title\">\n                        Proof of your\n                        <br data-kid=\"1-1-1-1-2-2-1\" data-name=\"title line break\"/>\n                        progress\n                    </h1>\n                </div>\n            </div>\n            <div class=\"mt-1 flex h-9 w-9 items-center justify-center border-[2px] border-(--ink)\" data-kid=\"1-1-1-2\" data-name=\"status indicator container\" style=\"background:var(--sun);\">\n                <i class=\"ti ti-check text-[18px] leading-none\" data-kid=\"1-1-1-2-1\" data-name=\"checkmark icon\" style=\"width:18px;height:18px;color:var(--ink);\">\n                </i>\n            </div>\n        </header>\n        <section aria-labelledby=\"trends-heading\" class=\"mb-8\" data-kid=\"1-1-2\" data-name=\"income trends section\">\n            <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"1-1-2-1\" data-name=\"income trends header\">\n                <div data-kid=\"1-1-2-1-1\" data-name=\"income trends heading container\">\n                    <p class=\"mb-1 text-[10px] font-bold uppercase tracking-[0.14em]\" data-kid=\"1-1-2-1-1-1\" data-name=\"income trends label\" style=\"color:var(--muted);\">\n                        Evidence, not estimates\n                    </p>\n                    <h2 class=\"font-display text-[22px] font-bold tracking-[-0.04em]\" data-kid=\"1-1-2-1-1-2\" data-name=\"income trends heading\" id=\"trends-heading\">\n                        Income trends\n                    </h2>\n                </div>\n                <span class=\"border-[2px] border-(--ink) px-2 py-1 text-[9px] font-bold uppercase tracking-[0.12em]\" data-kid=\"1-1-2-1-2\" data-name=\"timeframe badge\" style=\"background:var(--sun);\">\n                    7 days\n                </span>\n            </div>\n            <div aria-label=\"Bar chart showing daily income for the last seven days\" class=\"border-[3px] border-(--ink) p-3 shadow-[4px_4px_0_var(--ink)]\" data-kid=\"1-1-2-2\" data-name=\"income chart widget\" style=\"background:var(--paper);\">\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-1-2-2-1\" data-name=\"chart header\">\n                    <span class=\"text-[11px] font-semibold uppercase tracking-[0.11em]\" data-kid=\"1-1-2-2-1-1\" data-name=\"chart title\" style=\"color:var(--muted);\">\n                        Daily income\n                    </span>\n                    <span class=\"font-display text-[14px] font-bold\" data-kid=\"1-1-2-2-1-2\" data-name=\"total daily income\">\n                        KSh 8,400\n                    </span>\n                </div>\n                <div class=\"grid h-[138px] grid-cols-7 items-end gap-2 border-b-[3px] border-(--ink) pb-0\" data-kid=\"1-1-2-2-2\" data-name=\"chart bars container\">\n                    <div class=\"flex h-full flex-col items-center justify-end gap-1\" data-kid=\"1-1-2-2-2-1\" data-name=\"monday bar column\">\n                        <span class=\"font-display text-[9px] font-bold\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"monday income text\">\n                            900\n                        </span>\n                        <div class=\"w-full border-[2px] border-(--ink)\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"monday bar\" style=\"height:42px;background:var(--ink);\">\n                        </div>\n                        <span class=\"mt-1 text-[9px] font-bold uppercase\" data-kid=\"1-1-2-2-2-1-3\" data-name=\"monday label\" style=\"color:var(--muted);\">\n                            M\n                        </span>\n                    </div>\n                    <div class=\"flex h-full flex-col items-center justify-end gap-1\" data-kid=\"1-1-2-2-2-2\" data-name=\"tuesday bar column\">\n                        <span class=\"font-display text-[9px] font-bold\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"tuesday income text\">\n                            1.2k\n                        </span>\n                        <div class=\"w-full border-[2px] border-(--ink)\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"tuesday bar\" style=\"height:61px;background:var(--ink);\">\n                        </div>\n                        <span class=\"mt-1 text-[9px] font-bold uppercase\" data-kid=\"1-1-2-2-2-2-3\" data-name=\"tuesday label\" style=\"color:var(--muted);\">\n                            T\n                        </span>\n                    </div>\n                    <div class=\"flex h-full flex-col items-center justify-end gap-1\" data-kid=\"1-1-2-2-2-3\" data-name=\"wednesday bar column\">\n                        <span class=\"font-display text-[9px] font-bold\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"wednesday income text\">\n                            650\n                        </span>\n                        <div class=\"w-full border-[2px] border-(--ink)\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"wednesday bar\" style=\"height:31px;background:var(--ink);\">\n                        </div>\n                        <span class=\"mt-1 text-[9px] font-bold uppercase\" data-kid=\"1-1-2-2-2-3-3\" data-name=\"wednesday label\" style=\"color:var(--muted);\">\n                            W\n                        </span>\n                    </div>\n                    <div class=\"flex h-full flex-col items-center justify-end gap-1\" data-kid=\"1-1-2-2-2-4\" data-name=\"thursday bar column\">\n                        <span class=\"font-display text-[9px] font-bold\" data-kid=\"1-1-2-2-2-4-1\" data-name=\"thursday income text\">\n                            1.8k\n                        </span>\n                        <div class=\"w-full border-[2px] border-(--ink)\" data-kid=\"1-1-2-2-2-4-2\" data-name=\"thursday bar\" style=\"height:86px;background:var(--ink);\">\n                        </div>\n                        <span class=\"mt-1 text-[9px] font-bold uppercase\" data-kid=\"1-1-2-2-2-4-3\" data-name=\"thursday label\" style=\"color:var(--muted);\">\n                            T\n                        </span>\n                    </div>\n                    <div class=\"flex h-full flex-col items-center justify-end gap-1\" data-kid=\"1-1-2-2-2-5\" data-name=\"friday bar column\">\n                        <span class=\"font-display text-[9px] font-bold\" data-kid=\"1-1-2-2-2-5-1\" data-name=\"friday income text\">\n                            1.4k\n                        </span>\n                        <div class=\"w-full border-[2px] border-(--ink)\" data-kid=\"1-1-2-2-2-5-2\" data-name=\"friday bar\" style=\"height:70px;background:var(--ink);\">\n                        </div>\n                        <span class=\"mt-1 text-[9px] font-bold uppercase\" data-kid=\"1-1-2-2-2-5-3\" data-name=\"friday label\" style=\"color:var(--muted);\">\n                            F\n                        </span>\n                    </div>\n                    <div class=\"flex h-full flex-col items-center justify-end gap-1\" data-kid=\"1-1-2-2-2-6\" data-name=\"saturday bar column\">\n                        <span class=\"font-display text-[9px] font-bold\" data-kid=\"1-1-2-2-2-6-1\" data-name=\"saturday income text\">\n                            1.25k\n                        </span>\n                        <div class=\"w-full border-[2px] border-(--ink)\" data-kid=\"1-1-2-2-2-6-2\" data-name=\"saturday bar\" style=\"height:63px;background:var(--ink);\">\n                        </div>\n                        <span class=\"mt-1 text-[9px] font-bold uppercase\" data-kid=\"1-1-2-2-2-6-3\" data-name=\"saturday label\" style=\"color:var(--muted);\">\n                            S\n                        </span>\n                    </div>\n                    <div class=\"flex h-full flex-col items-center justify-end gap-1\" data-kid=\"1-1-2-2-2-7\" data-name=\"sunday bar column\">\n                        <span class=\"font-display text-[9px] font-bold\" data-kid=\"1-1-2-2-2-7-1\" data-name=\"sunday income text\">\n                            1.2k\n                        </span>\n                        <div class=\"w-full border-[2px] border-(--ink)\" data-kid=\"1-1-2-2-2-7-2\" data-name=\"sunday bar\" style=\"height:61px;background:var(--sun);\">\n                        </div>\n                        <span class=\"mt-1 text-[9px] font-bold uppercase\" data-kid=\"1-1-2-2-2-7-3\" data-name=\"sunday label\" style=\"color:var(--ink);\">\n                            S\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-2 flex items-center justify-between text-[9px] font-semibold uppercase tracking-[0.08em]\" data-kid=\"1-1-2-2-3\" data-name=\"chart date range\" style=\"color:var(--muted);\">\n                    <span data-kid=\"1-1-2-2-3-1\" data-name=\"start date\">\n                        01 Sep\n                    </span>\n                    <span data-kid=\"1-1-2-2-3-2\" data-name=\"end date\">\n                        Today · 07 Sep\n                    </span>\n                </div>\n            </div>\n            <div class=\"mt-5 grid h-[145px] grid-cols-12 gap-2\" data-kid=\"1-1-2-3\" data-name=\"metrics grid container\">\n                <div class=\"col-span-7 flex flex-col justify-between border-[3px] border-(--ink) p-3\" data-kid=\"1-1-2-3-1\" data-name=\"average income metric card\" style=\"background:rgba(3,192,60,.13);\">\n                    <span class=\"max-w-[95px] text-[10px] font-bold uppercase leading-[1.05] tracking-[0.08em]\" data-kid=\"1-1-2-3-1-1\" data-name=\"average income title\">\n                        Average daily income\n                    </span>\n                    <div data-kid=\"1-1-2-3-1-2\" data-name=\"average income details\">\n                        <span class=\"font-display text-[25px] font-bold leading-none tracking-[-0.06em]\" data-kid=\"1-1-2-3-1-2-1\" data-name=\"average income amount\">\n                            KSh 1,200\n                        </span>\n                        <div class=\"mt-2 h-1.5 w-16\" data-kid=\"1-1-2-3-1-2-2\" data-name=\"average income bar\" style=\"background:var(--jade);\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-span-3 flex flex-col justify-between border-[3px] border-(--ink) p-2.5\" data-kid=\"1-1-2-3-2\" data-name=\"best day metric card\" style=\"background:rgba(255,216,0,.42);\">\n                    <span class=\"text-[9px] font-bold uppercase leading-[1.05] tracking-[0.06em]\" data-kid=\"1-1-2-3-2-1\" data-name=\"best day title\">\n                        Best day\n                    </span>\n                    <div data-kid=\"1-1-2-3-2-2\" data-name=\"best day details\">\n                        <span class=\"font-display text-[17px] font-bold leading-none\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"best day name\">\n                            Friday\n                        </span>\n                        <div class=\"mt-2 h-1.5 w-9\" data-kid=\"1-1-2-3-2-2-2\" data-name=\"best day bar\" style=\"background:var(--ink);\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-span-2 flex flex-col justify-between border-[3px] border-(--ink) p-2\" data-kid=\"1-1-2-3-3\" data-name=\"total entries metric card\" style=\"background:var(--paper);\">\n                    <span class=\"text-[8px] font-bold uppercase leading-[1.05] tracking-[0.04em]\" data-kid=\"1-1-2-3-3-1\" data-name=\"total entries title\">\n                        Total entries\n                    </span>\n                    <div data-kid=\"1-1-2-3-3-2\" data-name=\"total entries details\">\n                        <span class=\"font-display text-[25px] font-bold leading-none\" data-kid=\"1-1-2-3-3-2-1\" data-name=\"total entries count\">\n                            42\n                        </span>\n                        <div class=\"mt-2 h-1.5 w-5\" data-kid=\"1-1-2-3-3-2-2\" data-name=\"total entries bar\" style=\"background:var(--ink);\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between gap-4 border-[3px] border-(--ink) px-3 py-3 shadow-[4px_4px_0_var(--ink)]\" data-kid=\"1-1-2-4\" data-name=\"consistency card\" style=\"background:var(--ink);color:var(--paper);\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-2-4-1\" data-name=\"consistency card info\">\n                    <svg aria-label=\"85 percent consistency, five of seven days logged\" class=\"h-[58px] w-[100px] shrink-0\" data-kid=\"1-1-2-4-1-1\" data-name=\"consistency progress ring\" role=\"img\" viewbox=\"0 0 120 70\">\n                        <path d=\"M10 60 A50 50 0 0 1 110 60\" fill=\"none\" stroke=\"rgba(250,250,250,.22)\" stroke-width=\"8\">\n                        </path>\n                        <path d=\"M10 60 A50 50 0 0 1 110 60\" fill=\"none\" stroke=\"var(--jade)\" stroke-dasharray=\"133 157\" stroke-linecap=\"butt\" stroke-width=\"8\">\n                        </path>\n                        <text fill=\"var(--paper)\" font-family=\"Space Grotesk, sans-serif\" font-size=\"17\" font-weight=\"700\" text-anchor=\"middle\" x=\"60\" y=\"56\">\n                            85%\n                        </text>\n                    </svg>\n                    <div data-kid=\"1-1-2-4-1-2\" data-name=\"consistency card labels\">\n                        <p class=\"font-display text-[14px] font-bold leading-none\" data-kid=\"1-1-2-4-1-2-1\" data-name=\"consistency card title\">\n                            Logging consistency\n                        </p>\n                        <p class=\"mt-1 text-[10px] leading-tight\" data-kid=\"1-1-2-4-1-2-2\" data-name=\"consistency card description\" style=\"color:rgba(250,250,250,.66);\">\n                            5 of 7 days logged\n                        </p>\n                    </div>\n                </div>\n                <i class=\"ti ti-arrow-up-right text-[19px] leading-none\" data-kid=\"1-1-2-4-2\" data-name=\"navigation arrow icon\" style=\"width:19px;height:19px;color:var(--sun);\">\n                </i>\n            </div>\n        </section>\n        <section aria-labelledby=\"statement-heading\" class=\"mb-7\" data-kid=\"1-1-3\" data-name=\"verified statement section\">\n            <div class=\"mb-3 flex items-end justify-between gap-3\" data-kid=\"1-1-3-1\" data-name=\"verified statement header\">\n                <div data-kid=\"1-1-3-1-1\" data-name=\"verified statement heading container\">\n                    <p class=\"mb-1 text-[10px] font-bold uppercase tracking-[0.14em]\" data-kid=\"1-1-3-1-1-1\" data-name=\"verified statement label\" style=\"color:var(--muted);\">\n                        Ready to hand over\n                    </p>\n                    <h2 class=\"font-display text-[22px] font-bold tracking-[-0.04em]\" data-kid=\"1-1-3-1-1-2\" data-name=\"verified statement heading\" id=\"statement-heading\">\n                        Verified statement\n                    </h2>\n                </div>\n                <span class=\"flex items-center gap-1 text-[10px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-1-3-1-2\" data-name=\"verification status\" style=\"color:var(--jade);\">\n                    <i class=\"ti ti-circle-check-filled text-[14px] leading-none\" data-kid=\"1-1-3-1-2-1\" data-name=\"verified check icon\" style=\"width:14px;height:14px;color:var(--jade);\">\n                    </i>\n                    Verified\n                </span>\n            </div>\n            <article aria-label=\"Kipato verified income statement for Amina Wanjiku\" class=\"relative overflow-hidden border-[3px] border-(--ink) shadow-[4px_4px_0_var(--ink)]\" data-kid=\"1-1-3-2\" data-name=\"statement ticket\" style=\"background:var(--paper);\">\n                <div class=\"h-3 border-b-[3px] border-(--ink)\" data-kid=\"1-1-3-2-1\" data-name=\"ticket header tab\" style=\"background:var(--sun);\">\n                </div>\n                <div class=\"kp-ticket-perforations absolute bottom-0 left-[-6px] top-3 w-2.5\" data-kid=\"1-1-3-2-2\" data-name=\"left perforation strip\">\n                </div>\n                <div class=\"kp-ticket-perforations absolute bottom-0 right-[-6px] top-3 w-2.5\" data-kid=\"1-1-3-2-3\" data-name=\"right perforation strip\">\n                </div>\n                <div class=\"px-5 pb-5 pt-4\" data-kid=\"1-1-3-2-4\" data-name=\"ticket content\">\n                    <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-3-2-4-1\" data-name=\"ticket top section\">\n                        <div data-kid=\"1-1-3-2-4-1-1\" data-name=\"ticket branding\">\n                            <p class=\"font-display text-[16px] font-bold leading-none tracking-[-0.03em]\" data-kid=\"1-1-3-2-4-1-1-1\" data-name=\"brand name\">\n                                KIPATO\n                            </p>\n                            <p class=\"mt-1 text-[9px] font-bold uppercase tracking-[0.18em]\" data-kid=\"1-1-3-2-4-1-1-2\" data-name=\"brand subtitle\" style=\"color:var(--muted);\">\n                                Verified income\n                            </p>\n                        </div>\n                        <div class=\"border-[2px] border-(--ink) px-2 py-1 text-right\" data-kid=\"1-1-3-2-4-1-2\" data-name=\"record reference\">\n                            <p class=\"text-[8px] font-bold uppercase tracking-[0.12em]\" data-kid=\"1-1-3-2-4-1-2-1\" data-name=\"record number label\" style=\"color:var(--muted);\">\n                                Record no.\n                            </p>\n                            <p class=\"font-display text-[11px] font-bold\" data-kid=\"1-1-3-2-4-1-2-2\" data-name=\"record number\">\n                                KP-0042\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-5\" data-kid=\"1-1-3-2-4-2\" data-name=\"worker section\">\n                        <p class=\"text-[9px] font-bold uppercase tracking-[0.14em]\" data-kid=\"1-1-3-2-4-2-1\" data-name=\"worker label\" style=\"color:var(--muted);\">\n                            Worker\n                        </p>\n                        <p class=\"mt-1 font-display text-[22px] font-bold leading-none tracking-[-0.045em]\" data-kid=\"1-1-3-2-4-2-2\" data-name=\"worker name\">\n                            Amina Wanjiku\n                        </p>\n                    </div>\n                    <div class=\"kp-ticket-rule my-5\" data-kid=\"1-1-3-2-4-3\" data-name=\"first divider\">\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-x-4 gap-y-4\" data-kid=\"1-1-3-2-4-4\" data-name=\"metrics list\">\n                        <div data-kid=\"1-1-3-2-4-4-1\" data-name=\"period metric\">\n                            <p class=\"text-[9px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-1-3-2-4-4-1-1\" data-name=\"period label\" style=\"color:var(--muted);\">\n                                Period\n                            </p>\n                            <p class=\"mt-1 font-display text-[12px] font-bold\" data-kid=\"1-1-3-2-4-4-1-2\" data-name=\"period range\">\n                                01 Sep — 30 Sep 2026\n                            </p>\n                        </div>\n                        <div data-kid=\"1-1-3-2-4-4-2\" data-name=\"entries metric\">\n                            <p class=\"text-[9px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-1-3-2-4-4-2-1\" data-name=\"entries label\" style=\"color:var(--muted);\">\n                                Entries\n                            </p>\n                            <p class=\"mt-1 font-display text-[12px] font-bold\" data-kid=\"1-1-3-2-4-4-2-2\" data-name=\"entries count\">\n                                42 records\n                            </p>\n                        </div>\n                        <div data-kid=\"1-1-3-2-4-4-3\" data-name=\"total declared metric\">\n                            <p class=\"text-[9px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-1-3-2-4-4-3-1\" data-name=\"total declared label\" style=\"color:var(--muted);\">\n                                Total declared\n                            </p>\n                            <p class=\"mt-1 font-display text-[20px] font-bold leading-none tracking-[-0.04em]\" data-kid=\"1-1-3-2-4-4-3-2\" data-name=\"total declared amount\">\n                                KSh 45,000\n                            </p>\n                        </div>\n                        <div data-kid=\"1-1-3-2-4-4-4\" data-name=\"mpesa metric\">\n                            <p class=\"text-[9px] font-bold uppercase tracking-[0.1em]\" data-kid=\"1-1-3-2-4-4-4-1\" data-name=\"mpesa label\" style=\"color:var(--muted);\">\n                                M-PESA backed\n                            </p>\n                            <p class=\"mt-1 font-display text-[20px] font-bold leading-none tracking-[-0.04em]\" data-kid=\"1-1-3-2-4-4-4-2\" data-name=\"mpesa percentage\" style=\"color:var(--jade);\">\n                                60%\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"kp-ticket-rule my-5\" data-kid=\"1-1-3-2-4-5\" data-name=\"second divider\">\n                    </div>\n                    <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-1-3-2-4-6\" data-name=\"representative entries header\">\n                        <span class=\"text-[9px] font-bold uppercase tracking-[0.12em]\" data-kid=\"1-1-3-2-4-6-1\" data-name=\"representative entries label\" style=\"color:var(--muted);\">\n                            Representative entries\n                        </span>\n                        <span class=\"text-[9px] font-semibold\" data-kid=\"1-1-3-2-4-6-2\" data-name=\"entries summary count\" style=\"color:var(--muted);\">\n                            3 of 42 shown\n                        </span>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"1-1-3-2-4-7\" data-name=\"entries list\">\n                        <div class=\"flex items-center justify-between border-b border-black/15 pb-2 text-[11px]\" data-kid=\"1-1-3-2-4-7-1\" data-name=\"entry one\">\n                            <span data-kid=\"1-1-3-2-4-7-1-1\" data-name=\"entry one info\">\n                                <b class=\"font-display\" data-kid=\"1-1-3-2-4-7-1-1-1\" data-name=\"entry one date\">\n                                    01 Sep\n                                </b>\n                                <span class=\"ml-2\" data-kid=\"1-1-3-2-4-7-1-1-2\" data-name=\"entry one detail\" style=\"color:var(--muted);\">\n                                    Cash · Transport\n                                </span>\n                            </span>\n                            <b class=\"font-display\" data-kid=\"1-1-3-2-4-7-1-2\" data-name=\"entry one amount\">\n                                KSh 1,200\n                            </b>\n                        </div>\n                        <div class=\"flex items-center justify-between border-b border-black/15 pb-2 text-[11px]\" data-kid=\"1-1-3-2-4-7-2\" data-name=\"entry two\">\n                            <span data-kid=\"1-1-3-2-4-7-2-1\" data-name=\"entry t
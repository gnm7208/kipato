# Backend configuration. DATABASE_URL and SECRET_KEY are required; the app
# refuses to start without them.
DATABASE_URL=postgresql://localhost/kipato
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Debug also returns email verification tokens in the API response, since a dev
# machine has no mail server. Never enable it in production.
FLASK_DEBUG=false
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# SMTP is optional: with no SMTP_HOST, verification emails are logged instead
# of sent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@kipato.app
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=no-reply@kipato.app

# Set to true only when the API and the frontend are on different sites, which
# requires the session cookie to be Secure + SameSite=None (HTTPS only). The
# Vercel deployment serves both from one origin and leaves this off.
CROSS_SITE_COOKIES=false

# In-process rate limiting counts one instance. Point this at Redis when the API
# runs on more than one.
RATELIMIT_STORAGE_URI=memory://
